{
  "version": "2.4.3",
  "description": "Manga, Novel, and Video reader for Android",
  "homepage": "https://github.com/Kototoro-app/Kototoro",
  "license": {
    "identifier": "Apache-2.0 license",
    "url": "https://github.com/Kototoro-app/Kototoro#Apache-2.0-1-ov-file"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/Kototoro-app/Kototoro/releases/download/v2.4.3/Kototoro-2.4.3-windows-x64-release.zip",
      "hash": "7071cb9dd218e99ca775b2c93bef4ef5fe4108eb7fbef15a113420eb1aceb3a4"
    }
  },
  "extract_dir": "Kototoro",
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Kototoro\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Kototoro\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "Kototoro.exe",
  "shortcuts": [
    [
      "Kototoro.exe",
      "Kototoro"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/Kototoro-app/Kototoro/releases",
    "jp": "$[0].tag_name",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Kototoro-app/Kototoro/releases/download/v$version/Kototoro-$version-windows-x64-release.zip"
      }
    }
  }
}