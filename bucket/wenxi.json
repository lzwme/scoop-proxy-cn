    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.asterlink\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "asterlink.exe",
  "shortcuts": [
    [
      "asterlink.exe",
      "AsterLink"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/z7786/wenxi/releases",
    "jp": "$[0].assets[*].browser_download_url",
    "regex": "/releases/download/(?<tag>[^/]+)/asterlink-([\\d.]+)%2B([\\d]+)-windows",
    "replace": "${1}+${2}"
