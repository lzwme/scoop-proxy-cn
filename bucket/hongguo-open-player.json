{
  "version": "1.7.3",
  "description": "红果开源播放器",
  "homepage": "https://github.com/zfdang/hongguo-open-player",
  "license": {
    "identifier": "AGPL-3.0 license",
    "url": "https://github.com/zfdang/hongguo-open-player#AGPL-3.0-1-ov-file"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v1.7.3/hongguo-open-player-1.7.3-win-x64-setup.exe#/dl.7z",
      "hash": "fe9603ac8321a32acd75921e86442ba9b389b29ce56ae011319fe7c59e05acc5",
      "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse",
        "Get-ChildItem \"$dir\\红果*.exe\" | Rename-Item -NewName 'hongguo-open-player.exe'"
      ]
    }
  },
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\hongguo-open-player\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\hongguo-open-player\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "hongguo-open-player.exe",
  "shortcuts": [
    [
      "hongguo-open-player.exe",
      "hongguo-open-player"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/zfdang/hongguo-open-player/releases",
    "jp": "$[0].tag_name",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/zfdang/hongguo-open-player/releases/download/v$version/hongguo-open-player-$version-win-x64-setup.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/SHA256SUMS.txt"
    }
  }
}