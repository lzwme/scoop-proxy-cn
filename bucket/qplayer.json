{
  "version": "1.9.5",
  "description": "A NetEase Cloud Music Player for Multi-Platform, Powered With QML4J Engine.",
  "homepage": "https://github.com/TIMER-err/qplayer",
  "license": {
    "identifier": "Apache-2.0 license",
    "url": "https://github.com/TIMER-err/qplayer#Apache-2.0-1-ov-file"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/TIMER-err/qplayer/releases/download/v1.9.5/QPlayer-windows-x64-setup.exe",
      "hash": "521b7367ac73abd2ca81874fbc51edcee6e87c5f001a0d5b9ffc82316348b833"
    }
  },
  "innosetup": true,
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:USERPROFILE\\.qplayer\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:USERPROFILE\\.qplayer\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "qplayer.exe",
  "shortcuts": [
    [
      "qplayer.exe",
      "QPlayer"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/TIMER-err/qplayer/releases/latest",
    "jp": "$.tag_name",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/TIMER-err/qplayer/releases/download/v$version/QPlayer-windows-x64-setup.exe"
      }
    }
  }
}