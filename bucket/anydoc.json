{
  "version": "0.2.2",
  "description": "Convert Word, PowerPoint, Excel, OpenDocument, RTF, EPUB, CSV, and PDF to clean Markdown",
  "homepage": "https://github.com/firecrawl/anydoc",
  "license": "MIT",
  "depends": "nodejs",
  "architecture": {
    "64bit": {
      "url": [
        "https://registry.npmjs.org/@firecrawl/anydoc/-/anydoc-0.2.2.tgz#/anydoc-main",
        "https://registry.npmjs.org/@firecrawl/anydoc-win32-x64-msvc/-/anydoc-win32-x64-msvc-0.2.2.tgz#/anydoc-native"
      ],
      "hash": [
        "9f1d60756ee02f59e80defe5c7447917e4b224c05771df077b7d67594929fab3",
        "8bcb7cd0e3718cf155ea7d54c1f069a5c9dc644a89f35c1bc5e43946584fdedc"
      ]
    }
  },
  "installer": {
    "script": [
      "Rename-Item \"$dir\\anydoc-main\" \"anydoc-main.tgz\"",
      "Expand-7zipArchive \"$dir\\anydoc-main.tgz\" \"$dir\" -Removal",
      "Move-Item \"$dir\\package\\*\" \"$dir\"",
      "Remove-Item \"$dir\\package\" -Recurse -Force",
      "New-Item \"$dir\\node_modules\\@firecrawl\" -ItemType Directory -Force | Out-Null",
      "Rename-Item \"$dir\\anydoc-native\" \"anydoc-native.tgz\"",
      "Expand-7zipArchive \"$dir\\anydoc-native.tgz\" \"$dir\\node_modules\\@firecrawl\" -Removal",
      "Rename-Item \"$dir\\node_modules\\@firecrawl\\package\" \"anydoc-win32-x64-msvc\"",
      "Set-Content \"$dir\\anydoc.cmd\" '@node \"%~dp0cli.js\" %*' -Encoding ASCII"
    ]
  },
  "bin": "anydoc.cmd",
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": [
          "https://registry.npmjs.org/@firecrawl/anydoc/-/anydoc-$version.tgz#/anydoc-main",
          "https://registry.npmjs.org/@firecrawl/anydoc-win32-x64-msvc/-/anydoc-win32-x64-msvc-$version.tgz#/anydoc-native"
        ]
      }
    }
  }
}