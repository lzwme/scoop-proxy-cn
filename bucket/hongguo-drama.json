  "homepage": "https://github.com/jackotom/hongguo-drama",
  "license": {
    "identifier": "GPL-3.0 license",
    "url": "https://github.com/jackotom/hongguo-drama#GPL-3.0-1-ov-file"
  },
  "architecture": {
    "64bit": {
      "url": "https://gh-proxy.org/https://github.com/jackotom/hongguo-drama/releases/download/v6.0/hongguo-downloader-6.0-win-x64.exe#/dl.7z",
      "hash": "1cea2092e123b4913f7e92f9fa710ac4fa05dd16cb941ce351632c0ff0152b57",
      "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "Get-ChildItem \"$dir\\红果*.exe\" | Rename-Item -NewName 'hongguo-drama.exe'",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse"
      ]
    }
  },
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\hongguo-downloader\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\hongguo-downloader\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "hongguo-drama.exe",
  "shortcuts": [
    [
      "hongguo-drama.exe",
      "hongguo-drama"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/jackotom/hongguo-drama/releases",
    "jp": "$..['tag_name', 'browser_download_url']",
    "regex": "v(?<tag>[\\d.]+).*?hongguo-downloader-([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://gh-proxy.org/https://github.com/jackotom/hongguo-drama/releases/download/v$matchTag/hongguo-downloader-$version-win-x64.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/SHA256SUMS.txt"
    }
  }
}