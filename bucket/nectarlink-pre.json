  "pre_install": [
    "Get-ChildItem -Path \"$dir\\`$_2_\" -Force | Move-Item -Destination \"$dir\\\" -Force",
    "Remove-Item \"$dir\\`$*\", \"$dir\\uninst*\" -Force -Recurse"
  ],
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\Nectarlink\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\Nectarlink\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": [
    [
      "nectarlink-desktop.exe",
      "NectarLink"
    ]
  ],
  "shortcuts": [
    [
      "nectarlink-desktop.exe",
      "NectarLink"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/thtbee/nectarlink/releases",
    "jp": "$[*].tag_name",
    "regex": "v([\\d.]+-[\\w.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/thtbee/nectarlink/releases/download/v$version/Nectarlink-$version-x64-setup.exe#/dl.7z"
      },
      "arm64": {
        "url": "https://github.com/thtbee/nectarlink/releases/download/v$version/Nectarlink-$version-x64-setup.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/SHA256SUMS.txt"
    }
  }
}