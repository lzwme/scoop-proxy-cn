{
  "version": "0.4.379",
  "description": "GUI client for herdr: Claude Code, Codex and pi agent sessions as clean chats.",
  "homepage": "https://alma.now",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://gh-proxy.org/https://github.com/yetone/alma-releases/releases/download/v0.4.379/alma-0.4.379-win-x64.exe#/dl.7z",
      "hash": "sha512:b8c9c2ee230c4981a3af7c513d98ef46c0104b6cbe3258987437236fb2bffbd5eb0ef252d1f3f2e5443aadce8d7f962d91d2eabe5fd901209509c45d84574fd6",
      "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
      ]
    }
  },
  "persist_external": [
    [
      "$env:AppData\\alma",
      "data",
      "directory"
    ],
    [
      "$env:USERPROFILE\\.config\\alma",
      "config",
      "directory"
    ],
    [
      "$env:USERPROFILE\\.alma",
      "activity",
      "directory"
    ],
    [
      "$env:USERPROFILE\\.cache\\alma",
      "cache",
      "directory"
    ]
  ],
  "post_install": [
    ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
    "Invoke-PersistExternalInstall -Manifest $manifest -PersistDir $persist_dir -Dir $dir"
  ],
  "pre_uninstall": [
    ". \"$(Find-BucketDirectory -Root -Name (coalesce $bucket 'muggle'))/scripts/persist-external.ps1\"",
    "Invoke-PersistExternalUninstall -Manifest $manifest -Dir $dir"
  ],
  "shortcuts": [
    [
      "Alma.exe",
      "Alma"
    ]
  ],
  "checkver": {
    "github": "https://github.com/yetone/alma-releases"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://gh-proxy.org/https://github.com/yetone/alma-releases/releases/download/v$version/alma-$version-win-x64.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/latest.yml",
      "regex": "$basename\\s+sha512:\\s+$base64"
    }
  }
}