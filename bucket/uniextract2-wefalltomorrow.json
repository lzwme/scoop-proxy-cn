  "url": "https://gh-proxy.org/https://github.com/wefalltomorrow/UniExtract2/releases/download/v3.1.8/UniExtract2-v3.1.8.zip",
  "hash": "1df29dd208f33bb07a35561fdb9786ef1e1fffa88dfb0e1e41dab6d2972f4842",
  "post_install": [
    "$ini = Get-Content \"$dir\\UniExtract.ini\" -Raw",
    "$new = $ini -replace '(?m)^updateinterval=\\d+', 'updateinterval=999999' -replace '(?m)^nightlyupdates=1', 'nightlyupdates=0'",
    "if ($new -ne $ini) { $new | Set-Content \"$dir\\UniExtract.ini\" -Encoding Ascii }"
  ],
  "bin": "UniExtract.exe",
  "persist": [
    "log",
    "UniExtract.ini"
  ],
  "shortcuts": [
    [
      "UniExtract.exe",
      "Universal Extractor"
    ]
  ],
  "checkver": "github",
  "autoupdate": {
    "url": "https://gh-proxy.org/https://github.com/wefalltomorrow/UniExtract2/releases/download/v$version/UniExtract2-v$version.zip"
  }
}