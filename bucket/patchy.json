{
  "version": "1.34",
  "description": "Open-source image editor focused on PSD compatibility and workflows familiar to Adobe Photoshop users.",
  "homepage": "https://github.com/SethRobinson/Patchy",
  "license": {
    "identifier": "MIT license",
    "url": "https://github.com/SethRobinson/Patchy#MIT-1-ov-file"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/SethRobinson/Patchy/releases/download/v1.34/PatchyWindowsInstaller.exe#/dl.7z",
      "hash": "67cde1a909e9b4f5f5d2a83af3629fd5377cb128f49264dddd35737cf93a50a0"
    },
    "arm64": {
      "url": "https://github.com/SethRobinson/Patchy/releases/download/v1.34/PatchyWindowsArm64Installer.exe#/dl.7z",
      "hash": "3d74138582c6a1a714ad68356a17f18ae1b5477e4a5a50cd425edfe1a6aec54f"
    }
  },
  "pre_install": [
    "Expand-7zipArchive \"$dir\\PatchyWindowsNoInstaller.zip\" \"$dir\"",
    "Move-Item -Path \"$dir\\Patchy\\*\" -Destination \"$dir\" -Force",
    "Remove-Item -Path \"$dir\\Patchy\" -Force -Recurse",
    "Remove-Item -Path \"$dir\\InstallPatchy.*\", \"$dir\\UninstallPatchy.exe\", \"$dir\\*.ico\", \"$dir\\*.txt\" -Force -ErrorAction SilentlyContinue"
  ],
  "installer": {
    "script": [
      "# handle runtime cache",
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\RTsoft\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "uninstaller": {
    "script": [
      "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name spc) scripts/AppsUtils.psm1)",
      "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\RTsoft\"",
      "Remove-Module -Name AppsUtils"
    ]
  },
  "bin": "patchy.exe",
  "shortcuts": [
    [
      "patchy.exe",
      "Patchy"
    ]
  ],
  "checkver": {
    "github": "https://api.github.com/repos/SethRobinson/Patchy/releases",
    "jp": "$[0].tag_name",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/SethRobinson/Patchy/releases/download/v$version/PatchyWindowsInstaller.exe#/dl.7z"
      },
      "arm64": {
        "url": "https://github.com/SethRobinson/Patchy/releases/download/v$version/PatchyWindowsArm64Installer.exe#/dl.7z"
      }
    },
    "hash": {
      "url": "$baseurl/SHA256SUMS.txt"
    }
  }
}